---
interface Props {
  title?: string;
}
const { title = "Let's see your packaging." } = Astro.props;
---
<section class="cta on-night" aria-labelledby="cta-title">
  <div class="container cta__inner">
    <div class="cta__copy">
      <h2 id="cta-title">{title}</h2>
      <p>
        <slot>
          Tell us what you serve and what you need. We'll reply with an all-in price per unit within
          <span class="ph-light">[1–2 business days]</span>.
        </slot>
      </p>
    </div>
    <a class="btn btn-kraft" href="/quote/">Request a quote <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .cta { border-top: 1px solid var(--night-line); }
  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(4rem, 9vw, 6.5rem);
  }
  .cta__copy { display: grid; gap: 1rem; }
  .cta p { font-size: var(--step-1); max-width: 48ch; }
  .cta :global(.ph-light) { color: var(--kraft-glow); font-weight: 600; }
</style>
