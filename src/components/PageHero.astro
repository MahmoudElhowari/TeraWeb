---
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---
<section class="page-hero on-night" aria-labelledby="page-title">
  <div class="container page-hero__inner">
    <span class="eyebrow rise">{eyebrow}</span>
    <h1 id="page-title" class="rise rise-2">{title}</h1>
    <div class="page-hero__lede rise rise-3"><slot /></div>
  </div>
</section>

<style>
  .page-hero { border-bottom: 1px solid var(--night-line); }
  .page-hero__inner {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(3rem, 6vw, 5rem);
  }
  .page-hero h1 { font-size: clamp(2.75rem, 1.6rem + 5vw, 5.5rem); max-width: 16ch; }
  .page-hero__lede { font-size: var(--step-1); max-width: 60ch; display: grid; gap: 1rem; }
</style>
