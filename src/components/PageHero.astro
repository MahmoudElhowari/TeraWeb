---
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---
<section class="page-hero" aria-labelledby="page-title">
  <div class="container page-hero__inner">
    <span class="eyebrow">{eyebrow}</span>
    <h1 id="page-title">{title}</h1>
    <div class="page-hero__lede"><slot /></div>
  </div>
</section>

<style>
  .page-hero { border-bottom: 2px solid var(--tera-green); }
  .page-hero__inner {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem);
  }
  .page-hero h1 { font-size: clamp(2.25rem, 1.5rem + 3.4vw, 4rem); max-width: 18ch; }
  .page-hero__lede { font-size: var(--step-1); color: var(--ink-muted); max-width: 60ch; display: grid; gap: 1rem; }
</style>
