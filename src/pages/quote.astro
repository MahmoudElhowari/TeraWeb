---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const businessTypes = [
  'Restaurant or takeout',
  'Café',
  'Bakery',
  'Grocer or specialty food store',
  'Other',
];

const packaging = [
  'Boxes and containers',
  'Bags',
  'Cups, lids and sleeves',
  'Labels, stickers and wraps',
  'Not sure yet',
];

const quantities = [
  'Under 1,000 per item',
  '1,000 to 2,999 per item',
  '3,000 to 9,999 per item',
  '10,000 or more per item',
  'Not sure yet',
];
---
<Base
  title="Request a quote | Tera Food & Supply"
  description="Tell us what you serve and what packaging you need. Tera will reply with an all-in price per unit for custom-branded packaging in Calgary."
>
  <PageHero eyebrow="Request a quote" title="Tell us about your packaging.">
    <p>
      A rough idea is enough. We'll reply with an all-in price per unit within
      <span class="ph">[1–2 business days]</span>.
    </p>
  </PageHero>

  <section class="section">
    <div class="container quote">
      <form
        name="quote"
        method="POST"
        action="/quote/thanks/"
        data-netlify="true"
        netlify-honeypot="company-website"
        enctype="multipart/form-data"
        class="form"
      >
        <input type="hidden" name="form-name" value="quote" />
        <p class="visually-hidden" aria-hidden="true">
          <label>Leave this field empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
        </p>

        <p class="form__note">Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.</p>

        <fieldset class="group">
          <legend>About you</legend>
          <div class="row">
            <div class="field">
              <label for="name">Your name <span class="req" aria-hidden="true">*</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="business">Business name <span class="req" aria-hidden="true">*</span></label>
              <input id="business" name="business" type="text" autocomplete="organization" required />
            </div>
          </div>
          <div class="row">
            <div class="field">
              <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>
          </div>
          <div class="field">
            <label for="business-type">Type of business <span class="req" aria-hidden="true">*</span></label>
            <select id="business-type" name="business-type" required>
              <option value="">Choose one</option>
              {businessTypes.map((t) => <option>{t}</option>)}
            </select>
          </div>
        </fieldset>

        <fieldset class="group">
          <legend>What you need</legend>
          <fieldset class="choices">
            <legend>Packaging you're interested in</legend>
            <div class="choices__grid">
              {packaging.map((p, i) => (
                <label class="choice" for={`pk-${i}`}>
                  <input id={`pk-${i}`} type="checkbox" name="packaging" value={p} />
                  <span>{p}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <div class="row">
            <div class="field">
              <label for="quantity">Rough quantity</label>
              <select id="quantity" name="quantity">
                <option value="">Choose one</option>
                {quantities.map((q) => <option>{q}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="needed-by">Needed by</label>
              <input id="needed-by" name="needed-by" type="date" aria-describedby="needed-by-hint" />
              <p id="needed-by-hint" class="hint">First orders take about <span class="ph">[X–Y weeks]</span>.</p>
            </div>
          </div>
          <div class="field">
            <label for="logo">Your logo</label>
            <input
              id="logo"
              name="logo"
              type="file"
              accept=".png,.jpg,.jpeg,.svg,.pdf,.ai,.eps"
              aria-describedby="logo-hint logo-error"
            />
            <p id="logo-hint" class="hint">Optional. PNG, JPG, SVG, PDF, AI or EPS, up to 8 MB.</p>
            <p id="logo-error" class="error" hidden>That file is over 8 MB. Choose a smaller file, or email it to us after you send this form.</p>
          </div>
          <div class="field">
            <label for="message">Anything else?</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              aria-describedby="message-hint"
            ></textarea>
            <p id="message-hint" class="hint">Your menu, how food is served or delivered, or packaging you like.</p>
          </div>
        </fieldset>

        <div class="submit">
          <button type="submit" class="btn btn-primary">Send my request <span aria-hidden="true">→</span></button>
          <p class="hint">
            We use your details only to reply to this request. See our <a href="/privacy/">privacy policy</a>.
          </p>
        </div>
      </form>

      <aside class="next" aria-labelledby="next-title">
        <h2 id="next-title">What happens next</h2>
        <ol>
          <li>
            <strong>We reply</strong>
            <span>Within <span class="ph">[1–2 business days]</span>, usually with a few questions.</span>
          </li>
          <li>
            <strong>We visit</strong>
            <span>We bring samples and see how your food is served and delivered.</span>
          </li>
          <li>
            <strong>You get a quote</strong>
            <span>An all-in price per unit, the lead time and a delivery plan. No obligation.</span>
          </li>
        </ol>
        <div class="next__contact">
          <p>Rather talk?</p>
          <p>Phone: <span class="ph">[phone]</span></p>
          <p>Email: <span class="ph">[email]</span></p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const MAX = 8 * 1024 * 1024;
  const input = document.getElementById('logo') as HTMLInputElement | null;
  const error = document.getElementById('logo-error');
  input?.addEventListener('change', () => {
    const tooBig = !!input.files?.[0] && input.files[0].size > MAX;
    input.setCustomValidity(tooBig ? 'File is over 8 MB' : '');
    if (error) error.hidden = !tooBig;
    input.setAttribute('aria-invalid', tooBig ? 'true' : 'false');
  });
</script>

<style>
  .quote {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .form { display: grid; gap: 2.5rem; }
  .form__note { font-size: var(--step--1); color: var(--ink-muted); }

  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  .group { display: grid; gap: 1.25rem; padding-top: 1.25rem; border-top: 2px solid var(--tera-green); }
  .group > legend {
    float: left;
    width: 100%;
    padding: 0;
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 115%;
    font-size: var(--step-2);
    color: var(--tera-green);
  }
  .group > legend + * { clear: both; }

  .row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .field { display: grid; gap: 0.4rem; align-content: start; min-width: 0; }
  label, .choices > legend { font-weight: 600; color: var(--ink); }
  .req { color: var(--kraft-text); }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  input[type='date'],
  select,
  textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.85rem;
    font: inherit;
    color: var(--ink);
    background: var(--white);
    border: 1.5px solid #9a9a8c;
    border-radius: var(--radius);
  }
  textarea { resize: vertical; min-height: 8rem; }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible { outline: 3px solid var(--kraft-text); outline-offset: 1px; border-color: var(--tera-green); }
  input[type='file'] { font: inherit; padding: 0.5rem 0; max-width: 100%; }
  input[type='file']::file-selector-button {
    margin-right: 0.75rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    font: inherit;
    font-weight: 600;
    color: var(--tera-green);
    background: var(--white);
    border: 2px solid var(--tera-green);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .hint { font-size: var(--step--1); color: var(--ink-muted); }
  .error { font-size: var(--step--1); color: #a12c1c; font-weight: 600; }

  .choices { display: grid; gap: 0.6rem; }
  .choices > legend { padding: 0; margin-bottom: 0.6rem; }
  .choices__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  .choice {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
    padding: 0.6rem 0.85rem;
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    font-weight: 500;
    cursor: pointer;
  }
  .choice:has(input:checked) { border-color: var(--tera-green); background: #eef3ec; }
  .choice input { width: 1.15rem; height: 1.15rem; accent-color: var(--tera-green); flex: none; }

  .submit { display: grid; gap: 0.85rem; justify-items: start; }

  .next {
    display: grid;
    gap: 1.5rem;
    padding: 1.75rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    position: sticky;
    top: 1.5rem;
  }
  .next h2 { font-size: var(--step-2); }
  .next ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; counter-reset: n; }
  .next li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.85rem;
    counter-increment: n;
  }
  .next li::before {
    content: counter(n);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 2px solid var(--tera-green);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--tera-green);
  }
  .next li strong { color: var(--tera-green); }
  .next li > span { font-size: var(--step--1); color: var(--ink-muted); }
  .next__contact { padding-top: 1.25rem; border-top: 1px dashed var(--line); display: grid; gap: 0.25rem; font-size: var(--step--1); }
  .next__contact p:first-child { font-weight: 700; color: var(--ink); }

  @media (max-width: 900px) {
    .quote { grid-template-columns: 1fr; }
    .next { position: static; }
  }
  @media (max-width: 560px) {
    .row, .choices__grid { grid-template-columns: 1fr; }
    .submit .btn { width: 100%; }
  }
</style>
