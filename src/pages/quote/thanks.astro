---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Thanks for your request | Tera Food & Supply"
  description="We've received your quote request and will reply soon."
>
  <meta slot="head" name="robots" content="noindex" />
  <section class="section">
    <div class="container thanks">
      <span class="eyebrow">Request sent</span>
      <h1>Thanks. We've got it.</h1>
      <p>
        We'll reply within <span class="ph">[1–2 business days]</span>, usually with a few questions about your menu and
        how your food is served. Then we'll set up a time to visit with samples.
      </p>
      <div class="thanks__actions">
        <a class="btn btn-green" href="/packaging/">Browse packaging</a>
        <a class="btn btn-outline" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .thanks { display: grid; gap: 1.25rem; justify-items: start; padding-block: clamp(2rem, 6vw, 5rem); }
  .thanks p { font-size: var(--step-1); color: var(--ink-muted); }
  .thanks__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
</style>
